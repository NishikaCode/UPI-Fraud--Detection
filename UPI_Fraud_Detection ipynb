    ")\n",
    "\n",
    "cat_cols2 = X_reduced.select_dtypes(include=[\"object\"]).columns.tolist()\n",
    "num_cols2 = X_reduced.select_dtypes(include=[\"number\"]).columns.tolist()\n",
